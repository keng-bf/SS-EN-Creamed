draw_text_scribble_ext(480, 270, string_hash_to_newline("[fa_center][fa_middle][npcfont][shake][c_red]HEY!##[c_white]This game expects you to have played Pizza Tower beforehand. Otherwise, you may have some trouble!#If you haven't played Pizza Tower...##[c_red]GO PLAY IT!#Port Made By: keng-bf and anton669##[c_white]Press shift to continue."), 900);